---
/**
 * Contact: the heading rises into place once in view over 1100 ms (`data-reveal="slow"` in
 * `motion.css`), then three pill buttons (email, WhatsApp, CV) that grow on hover, and a row with
 * the address, its Copy button, the phone and the profiles.
 *
 * "Send an email" is a plain `mailto:` link; with JavaScript, `src/scripts/contact.ts` opens the
 * "Write to me" dialog (`MailDialog`) from it instead. The Copy button needs JavaScript, so it
 * shows only with it; its labels and announcements are all here, picked by `data-copy-state`
 * (`idle` / `ok` / `fail`).
 */
import MailDialog from '../components/MailDialog.astro';
import { contact, mailtoHref, whatsappHref } from '../data/contact';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).contact;
const mailHref = mailtoHref(copy.emailSubject);
const waHref = whatsappHref(copy.whatsappText);
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="heading" data-reveal="slow">
    {copy.heading}
  </h2>
  <p class="intro">{copy.intro}</p>
  <div class="buttons">
    <a class="button button-email" href={mailHref} data-mail-open>
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="3"></rect>
        <path d="M4 7.5l8 5.5 8-5.5"></path>
      </svg>
      {copy.email}
    </a>
    <a class="button button-whatsapp" href={waHref} target="_blank" rel="noopener">
      <svg width="21" height="21" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
      </svg>
      {copy.whatsapp}
    </a>
    <a class="button button-cv" href={contact.cv} download>
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 4v11"></path>
        <path d="M7 10.5l5 4.5 5-4.5"></path>
        <path d="M5 20h14"></path>
      </svg>
      {copy.cv}
    </a>
  </div>
  <div class="links">
    <span class="email" data-copy data-copy-state="idle" data-address={contact.email}>
      <a href={mailHref} data-copy-address>
        {contact.email}
      </a>
      <button type="button" class="copy" data-copy-button>
        <span data-copy-label="idle">{copy.copy.idle}</span>
        <span data-copy-label="ok">{copy.copy.ok}</span>
        <span data-copy-label="fail">{copy.copy.fail}</span>
      </button>
      <span class="sr-only" role="status" aria-live="polite">
        <span data-copy-label="ok">{copy.copy.okMessage}</span>
        <span data-copy-label="fail">{copy.copy.failMessage}</span>
      </span>
    </span>
    <a href={waHref} target="_blank" rel="noopener">
      {contact.phone}
    </a>
    <a href={contact.linkedin} target="_blank" rel="noopener">
      {copy.linkedin}
    </a>
    <a href={contact.github} target="_blank" rel="noopener">
      {copy.github}
    </a>
  </div>
</section>

<MailDialog locale={locale} />

<script>
  import '../scripts/reveal';
  import '../scripts/contact';
</script>

<style>
  .contact {
    padding: var(--space-fluid-contact) var(--space-24);
    text-align: center;
  }

  .heading {
    font-size: var(--font-size-contact);
    line-height: var(--line-height-contact);
    letter-spacing: -0.055em;
    font-weight: 800;
    margin: 0 auto;
    max-width: var(--size-phil);
    text-wrap: balance;
  }

  .intro {
    font-size: var(--font-size-ai-intro);
    line-height: var(--line-height-relaxed);
    color: var(--color-muted);
    max-width: var(--size-narrow);
    margin: var(--space-28) auto 0;
  }

  .buttons {
    display: flex;
    gap: var(--space-12);
    flex-wrap: wrap;
    justify-content: center;
    max-width: var(--size-ai-intro);
    margin: var(--space-48) auto 0;
  }

  .button {
    flex: 1 1 var(--size-contact-button);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-10);
    white-space: nowrap;
    font-size: var(--font-size-18);
    font-weight: 500;
    padding: var(--space-18) var(--space-28);
    border-radius: var(--radius-pill);
  }

  .button svg {
    flex-shrink: 0;
  }

  .button-email,
  .button-email:hover {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .button-whatsapp,
  .button-whatsapp:hover {
    font-weight: 600;
    background: var(--color-whatsapp);
    color: var(--color-ink);
  }

  .button-whatsapp:hover {
    background: var(--color-whatsapp-hover);
  }

  .button-email:hover {
    box-shadow: var(--shadow-button);
  }

  .button-whatsapp:hover {
    box-shadow: var(--shadow-whatsapp);
  }

  .button-cv {
    padding: var(--space-17) var(--space-28);
    border: var(--size-hairline) solid var(--color-line-strong);
  }

  .button-cv:hover {
    background: var(--color-surface);
  }

  .links {
    display: flex;
    gap: var(--space-12) var(--space-28);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: var(--space-40);
    font-size: var(--font-size-16);
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
  }

  /* Copying needs JavaScript, so the button shows only with it. */
  .copy {
    display: none;
    font: inherit;
    font-size: var(--font-size-14);
    font-weight: 600;
    cursor: pointer;
    padding: var(--space-5) var(--space-10);
    border-radius: var(--radius-pill);
    border: var(--size-hairline) solid var(--color-ring);
    background: var(--color-transparent);
    color: var(--color-ink);
  }

  :global(html.js) .copy {
    display: inline-block;
  }

  [data-copy-state='ok'] .copy {
    background: var(--color-ink);
    color: var(--color-white);
  }

  [data-copy-state='fail'] .copy {
    border-color: var(--color-error);
    color: var(--color-error);
  }

  [data-copy-label] {
    display: none;
  }

  [data-copy-state='idle'] [data-copy-label='idle'],
  [data-copy-state='ok'] [data-copy-label='ok'],
  [data-copy-state='fail'] [data-copy-label='fail'] {
    display: inline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        transform var(--dur-press) var(--ease-out),
        box-shadow var(--dur-press),
        background var(--dur-press);
    }

    .button:hover {
      transform: scale(1.04);
    }

    .copy {
      transition:
        background var(--dur-press),
        color var(--dur-press),
        border-color var(--dur-press);
    }
  }
</style>
