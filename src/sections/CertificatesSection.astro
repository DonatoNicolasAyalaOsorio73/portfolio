---
/**
 * Certifications: four cards that tip up into place once in view, 160 ms apart
 * (`data-reveal="cert"` in `motion.css`); in each, a coloured halo grows, the logo springs in and
 * the "Verified" badge pops in last. Each logo drifts with the section's scroll progress `--p`
 * (written by `scenes.ts`) at its certificate's `speed` and tilts toward the pointer (`tilt.ts`).
 * The logo area links to the credential too, but is skipped by the keyboard and assistive
 * technology, so each certificate has one stop: its "View certificate" link. Without JavaScript
 * or with reduced motion every card, halo, logo and badge is in its final state and the logos
 * rest without offset.
 */
import { Picture } from 'astro:assets';
import ProjectVars from '../components/ProjectVars.astro';
import { certificates } from '../data/about';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).certificates;

/** The logo row's largest height in px (`--size-cert-logo`), for `sizes`. */
const LOGO_HEIGHT = 260;

/** Joins each certificate to its dictionary entry; a missing one is a build error. */
const cards = certificates.map((cert) => {
  const text = copy.items.find((item) => item.id === cert.id);
  if (!text) throw new Error(`No ${locale} copy for certificate "${cert.id}"`);
  return { ...cert, ...text };
});
---

<section class="certificates" aria-labelledby="cert-title" data-scene="pass">
  <div class="inner">
    <h2 id="cert-title" class="heading">
      {copy.heading}
    </h2>
    <div class="grid">
      {cards.map((cert, index) => (
        <ProjectVars
          vars={{
            speed: `${cert.speed}px`,
            halo: cert.halo,
            'logo-radius': cert.radius,
            'logo-blend': cert.blend,
          }}
        >
          <article class="cert" data-reveal="cert" data-index={index}>
            <a
              class="float"
              href={cert.href}
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
            >
              <span class="halo" data-reveal-part="halo" />
              <span class="logo" data-reveal-part="logo">
                <Picture
                  src={cert.logo}
                  formats={['avif', 'webp']}
                  widths={[Math.round(cert.logo.width / 2), cert.logo.width]}
                  sizes={`${Math.round((LOGO_HEIGHT * cert.logo.width) / cert.logo.height)}px`}
                  width={cert.logo.width}
                  height={cert.logo.height}
                  alt={cert.logoAlt}
                  loading="lazy"
                  decoding="async"
                  fallbackFormat="webp"
                  data-tilt
                />
              </span>
            </a>
            <div class="body">
              <span class="badge" data-reveal-part="badge">
                <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                {copy.verified}
              </span>
              <div class="issuer">
                {cert.issuer} · {cert.year}
              </div>
              <h3 class="name">{cert.name}</h3>
              <a
                class="view"
                href={cert.href}
                target="_blank"
                rel="noopener"
                aria-label={`${cert.name} — ${copy.viewLabel}`}
              >
                {copy.view}
              </a>
            </div>
          </article>
        </ProjectVars>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/reveal';
  import '../scripts/scenes';
  import '../scripts/tilt';
</script>

<style>
  .certificates {
    padding: var(--space-fluid-work) var(--space-24);
    background: var(--color-surface);
  }

  .inner {
    max-width: var(--size-content);
    margin: 0 auto;
    text-align: center;
  }

  .heading {
    font-size: var(--font-size-heading);
    line-height: var(--line-height-heading);
    letter-spacing: -0.05em;
    font-weight: 800;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-cert-column)), 1fr));
    gap: var(--space-fluid-cert-row) var(--space-fluid-cert-col);
    margin-top: var(--space-fluid-about-top);
    perspective: var(--size-seq);
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-28);
  }

  .float {
    position: relative;
    height: var(--size-cert-logo);
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The halo's final state: centred on the logo at full size. */
  .halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--size-halo);
    aspect-ratio: 1;
    border-radius: var(--radius-round);
    background: radial-gradient(closest-side, var(--halo), var(--color-transparent));
    transform: translate(-50%, -50%) scale(1);
    pointer-events: none;
  }

  .logo {
    position: relative;
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo :global(picture) {
    display: contents;
  }

  .logo :global(img) {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--logo-radius);
    mix-blend-mode: var(--logo-blend);
    filter: drop-shadow(var(--shadow-logo-about));
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    font-size: var(--font-size-13);
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: var(--space-6) var(--space-12) var(--space-6) var(--space-9);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-white);
    margin-bottom: var(--space-14);
  }

  .badge svg {
    fill: none;
    stroke: currentcolor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .issuer {
    font-size: var(--font-size-14);
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--color-muted);
  }

  .name {
    font-size: var(--font-size-22);
    line-height: var(--line-height-cert-title);
    letter-spacing: -0.025em;
    font-weight: 700;
    margin: var(--space-10) 0 0;
    text-wrap: balance;
  }

  .view {
    display: inline-block;
    margin-top: var(--space-14);
    font-size: var(--font-size-15);
    font-weight: 500;
    white-space: nowrap;
    padding: var(--space-9) var(--space-16);
    border-radius: var(--radius-pill);
    border: var(--size-hairline) solid var(--color-line-strong);
  }

  .view:hover {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Drifts from +speed/2 to −speed/2 as the section passes through the viewport. */
    .float {
      transform: translateY(calc((0.5 - var(--p, 0.5)) * var(--speed)));
    }

    .view {
      transition: transform var(--dur-press) var(--ease-out);
    }
  }

  /* The halo is centred with a transform, which print resets, so it is left out. */
  @media print {
    .halo {
      display: none;
    }
  }
</style>
